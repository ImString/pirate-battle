{
	"trailingComma": "none",
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"bracketSameLine": true,
	"arrowParens": "avoid",
	"endOfLine": "auto",
	"printWidth": 120,

	"importOrder": ["^@/pages/?(.*)$", "^@/components/?(.*)$", "^@/utils/?(.*)$", "^[./]"],
	"importOrderSeparation": true,
	"importOrderParserPlugins": ["typescript", "jsx"],

	"plugins": ["prettier-plugin-tailwindcss", "@trivago/prettier-plugin-sort-imports"]
}
