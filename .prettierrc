{
	"trailingComma": "none",
	"semi": true,
	"tabWidth": 4,
	"useTabs": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"bracketSameLine": true,
	"arrowParens": "avoid",
	"endOfLine": "auto",
	"printWidth": 120,

	"importOrder": ["^@/pages/?(.*)$", "^@/features/?(.*)$", "^@/shared/?(.*)$", "^[./]"],
	"importOrderSeparation": true,
	"importOrderParserPlugins": ["typescript", "jsx"],

	"plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"]
}
